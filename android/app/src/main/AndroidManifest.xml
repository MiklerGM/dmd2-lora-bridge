<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- DMD2 registers its LoRa receiver demanding this permission of senders whenever the
         genuine DMD-LoRa package is absent, so we must define it (nobody else will) and hold
         it. See docs/PROTOCOL.md §1. -->
    <permission
        android:name="com.thorkracing.dmdlora.permission.LORA_BRIDGE"
        android:protectionLevel="normal" />
    <uses-permission android:name="com.thorkracing.dmdlora.permission.LORA_BRIDGE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Sideloaded utility: the rider is asked directly rather than sent hunting through
         settings, because a killed bridge means no positions for the rest of the ride. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Only for the GPS check in Tools, asked for when it is first pressed: the bridge itself
         never needs to know where it is. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- To open DMD2 from the checks; package visibility hides it otherwise. -->
    <queries>
        <package android:name="com.thorkracing.dmd2launcher" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="LoRa Bridge for DMD2"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <!-- The launcher names the app by this label: the full one did not fit under the icon. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:label="LoRa Bridge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Class path is mandatory: DMD2 targets it by explicit ComponentName.

            Deliberately left without android:permission, and that is measured rather than
            assumed. Guarding it with LORA_BRIDGE is the safer default, but DMD2 does not hold
            that permission: 4.017 (versionCode 400116, read with dumpsys on hardware
            2026-09-16) requests no LoRa-bridge permission of any kind - its only
            Thork-namespace entries are advsos THEFT_CONTROL and its own dynamic-receiver
            permission. With the guard in place the system silently drops every SET_FREQUENCY
            and SEND_GROUP_DATA, so the bridge pairs, reports a perfectly healthy radio and
            never receives one packet.

            The exposure is real and unchanged: any local app can push fake positions or move
            our radio. That is why a malformed SET_FREQUENCY revokes the region outright rather
            than being merged into the running one - see Dmd2CommandReceiver.
            ponytail: unprotected because DMD2 cannot reach us otherwise; re-add
            android:permission only after checking with dumpsys that the DMD2 build actually
            in use requests it.
        -->
        <receiver
            android:name=".receiver.Dmd2CommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.thorkracing.dmdlora.SEND_GROUP_DATA" />
                <action android:name="com.thorkracing.dmdlora.SEND_CHAT_MESSAGE" />
                <action android:name="com.thorkracing.dmdlora.SET_FREQUENCY" />
                <action android:name="com.thorkracing.dmdlora.STOP" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Likewise mandatory, and unprotected for the same measured reason as the receiver
             above: DMD2 calls startForegroundService on this exact component. -->
        <service
            android:name=".service.LoraService"
            android:exported="true"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>

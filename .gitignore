firmware/.pio/
# Generated from sdkconfig.defaults on the first build and then kept, which is a trap:
# PlatformIO will not revisit them when the defaults change, so a stale one silently
# builds with the old configuration. They are artefacts, not sources.
firmware/sdkconfig.*
!firmware/sdkconfig.defaults
firmware/dist/

# The lab: bench run logs (lab/results), the RadioLib probe project and one-off analyses. Kept
# on the bench machine, not in git: data is not source, and the history is no place for it.
lab/
